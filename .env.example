#API_Key鉴权（留空 = 服务锁死）
AUTH_KEY = 

# LLM API配置
MODEL = deepseek-v4-flash
API_KEY = 
BASE_URL = https://api.deepseek.com/v1
# LLM 默认参数
SYSTEM_PROMPT = 你是一个有用的助手
DEFAULT_TEMPERATURE = 0.7
MAX_CONTENT_LENGTH = 5
MAX_INPUT_LENGTH=2000

# 应用元数据
APP_TITLE = Copywriter Agent
APP_DESCRIPTION = AI文案助手
APP_VERSION = 1.0.0
# 服务器配置
API_HOST = 0.0.0.0
API_PORT = 8000
RELOAD = true


# 数据库
DB_HOST = localhost
DB_PORT = 5432
DB_DATABASE = postgres
DB_USER = 
DB_PASSWORD = 